@using Aspire.PythonModelRunner.Shared
@using Microsoft.FeatureManagement

@inject IFeatureManager FeatureManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@ApplicationConstants.Name</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        @if (_useEntraAuthentication == true)
        {
            <AuthorizeView>
                <Authorized>
                    <div class="nav-item px-3">
                        <span class="nav-link disabled text-truncate" title="@context.User.Identity?.Name">
                            @context.User.Identity?.Name
                        </span>
                    </div>
                    <div class="nav-item px-3">
                        <a class="nav-link" href="/logout">
                            <span class="me-2" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M6 3H4a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h2"></path>
                                    <path d="M10 11l3-3-3-3"></path>
                                    <path d="M13 8H6"></path>
                                </svg>
                            </span> Logout
                        </a>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="nav-item px-3">
                        <a class="nav-link" href="/login">
                            <span class="me-2" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M8 2v6"></path>
                                    <path d="M5.5 4.5L8 2l2.5 2.5"></path>
                                    <path d="M3 8v4a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V8"></path>
                                </svg>
                            </span> Login
                        </a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        }
    </nav>
    
    @code {
        private bool? _useEntraAuthentication;

        protected override async Task OnInitializedAsync()
        {
            _useEntraAuthentication =
                await FeatureManager.IsEnabledAsync(FeatureFlags.UseEntraAuthentication);
        }
    }
</div>
